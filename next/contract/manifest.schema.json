{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archive.aero/next/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "generated",
    "tileBase",
    "fileBase",
    "eras",
    "basemap",
    "airspace",
    "airfields",
    "pins",
    "coverage"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "generated": {
      "type": "string",
      "format": "date-time"
    },
    "tileBase": {
      "type": "string",
      "format": "uri",
      "pattern": "/$"
    },
    "fileBase": {
      "type": "string",
      "format": "uri",
      "pattern": "/$"
    },
    "eras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "k",
          "h",
          "b",
          "z",
          "c"
        ],
        "properties": {
          "k": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}_to_\\d{4}-\\d{2}-\\d{2}$"
          },
          "h": {
            "type": "string",
            "pattern": "^[a-f0-9]{12}$"
          },
          "b": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              }
            ]
          },
          "z": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 24
            }
          },
          "c": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4095
                }
              }
            ]
          }
        }
      }
    },
    "basemap": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p",
            "z",
            "tileSize"
          ],
          "properties": {
            "p": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_.-]+\\.[a-f0-9]{12}$"
            },
            "z": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              }
            },
            "tileSize": {
              "const": 512
            },
            "format": {
              "enum": [
                "raster",
                "mvt"
              ]
            },
            "flavor": {
              "enum": [
                "light",
                "dark",
                "white",
                "grayscale",
                "black"
              ]
            },
            "lang": {
              "type": "string",
              "pattern": "^[A-Za-z-]{2,12}$"
            }
          }
        }
      ]
    },
    "airspace": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p",
            "z"
          ],
          "properties": {
            "p": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9_-]+/)+[A-Za-z0-9_.-]+\\.[a-f0-9]{12}$"
            },
            "z": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 24
              }
            }
          }
        }
      ]
    },
    "airfields": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bin",
            "details"
          ],
          "properties": {
            "bin": {
              "type": "string",
              "pattern": "^next/airfields\\.[a-f0-9]{12}\\.bin$"
            },
            "details": {
              "type": "string",
              "pattern": "^next/airfields\\.[a-f0-9]{12}\\.json$"
            }
          }
        }
      ]
    },
    "pins": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "z",
            "margin",
            "base",
            "shards"
          ],
          "properties": {
            "z": {
              "const": 5
            },
            "margin": {
              "type": "number",
              "minimum": 0
            },
            "base": {
              "type": "string",
              "pattern": "^next/pins\\.[a-f0-9]{12}/$"
            },
            "shards": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1023
              }
            }
          }
        }
      ]
    },
    "coverage": {
      "type": "object"
    }
  }
}
