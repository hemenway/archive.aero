# ---------------------------------------------------------------- errors

# What a worklist needs from a run: every job that did not succeed, and every
# problem line the slicer printed inside jobs that did (a chart that failed to
# warp while its era's mosaic completed with the others). Read from the
# server's job records and logs, so it can be rerun at any point of a run.
PROBLEM_RX = "✗|⚠|No source files found|no data available|Warning: |Traceback"
ENGINE_LINE = re.compile(r"^\[\d{4}-\d\d-\d\d \d\d:\d\d:\d\d\] ")  # the controller's own lines repeat the job error
SLICER_STAMP = re.compile(r"^\[\d\d:\d\d:\d\d\]\s*")
NOISE = re.compile(r"Skipping print-size PDF")
SOURCE_EXT = re.compile(r"\.(?:tiff?|zip|pdf|jpe?g|png|vrt)\b", re.I)
LEAD_IN = re.compile(r"(?:\b(?:for|open|into|inside|from|payload|member|Skipping|Warping)|found:|failed:|download:|PDF:)\s+")
CAUSES = [  # first match names the cause
    ("download", r"Download failed|Failed to download|Downloaded but extraction failed|Connection error"),
    ("zip", r"Extraction failed|ZIP payload|No member named|Don't know how to turn member"),
    ("16-bit rescale", r"8-bit rescale failed"),
    ("pdf", r"PDF"),
    ("no source file", r"No source files found|Input file not found"),
    ("no data for era", r"no data available|No valid input files for mosaic"),
    ("catalog row", r"fix the dole row|row carries GCPs|container members share cutline"),
    ("chart artifact", r"chart URI|chart pmtiles|Chart pmtiles|geotiff2pmtiles"),
    ("no crs", r"no embedded CRS"),
    ("gcp", r"GCP"),
    ("cutline", r"[Ss]hapefile|[Cc]utline"),
    ("unreadable source", r"Could not open|Cannot open|too small|unreadable"),
    ("antimeridian", r"antimeridian|full-world"),
    ("warp", r"[Ww]arp"),
    ("mosaic", r"[Mm]osaic"),
    ("alignment", r"misaligned|alignment"),
    ("overlay remount", r"overlay|remount"),
    ("disk space", r"SSD free space|No space left"),
    ("interrupted", r"controller restarted|cancelled|interrupted"),
]


def cause_of(text):
    for name, rx in CAUSES:
        if re.search(rx, text):
            return name
    return "other"


def source_file(text):
    """The source file a slicer line is about (names can hold spaces: 'Washington SEC 97.tif')."""
    m = re.search(r"\[CSV: ([^\]]+)\]", text)
    if m:
        return None if m.group(1) == "no match" else m.group(1).strip()
    m = SOURCE_EXT.search(text)
    if not m:
        return None
    head = text[:m.end()]
    cuts = [c.end() for c in LEAD_IN.finditer(head)]
    name = head[cuts[-1]:] if cuts else head.split()[-1]
    return name.strip(" :'\"") or None


def cmd_errors(a):
    run = a.run
    rows = api("GET", f"/api/jobs?run={urllib.request.quote(run)}&limit=1000000")
    if not rows:
        sys.exit(f"slicerctl: no jobs for run {run}")
    rows.reverse()  # oldest first
    finished = [r for r in rows if r["status"] not in ("queued", "running")]
    records = []

    def rec(row, severity, text, **extra):
        records.append({"run": run, "key": row.get("key"), "job": row["id"], "step": row["type"],
                        "severity": severity, "cause": extra.pop("cause", None) or cause_of(text),
                        "text": text, "file": source_file(text) if row["type"] == "slice" and severity != "failed" else None,
                        "finished": row.get("finished"), **extra})

    def inspect(row):
        """(row, job detail or None, slicer problem lines) for one finished job."""
        detail, lines = None, []
        if row["type"] in ("slice", "convert") and row.get("started"):
            detail = api("GET", f"/api/jobs/{row['id']}")
        if row["type"] == "slice" and row.get("started"):
            raw = api("GET", f"/api/jobs/{row['id']}/log?lines=5000&grep={urllib.request.quote(PROBLEM_RX)}")
            seen = set()
            for ln in raw:
                if ENGINE_LINE.match(ln) or NOISE.search(ln):
                    continue
                ln = SLICER_STAMP.sub("", ln).strip()
                if ln and ln not in seen:  # a retried slice prints its problems twice
                    seen.add(ln)
                    lines.append(ln)
        elif row["status"] == "failed":
            lines = [ln for ln in api("GET", f"/api/jobs/{row['id']}/log?lines=12") if ln.strip()]
        return row, detail, lines

    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        inspected = list(ex.map(inspect, finished))
    for row, detail, lines in inspected:
        res = (detail or {}).get("result") or {}
        hard = lambda ln: "✗" in ln or "No source files found" in ln or "no data available" in ln
        if row["status"] != "succeeded":
            err = row.get("error") or row["status"]
            cause = None
            if err.startswith("dependency "):
                cause = "earlier step failed"
            elif row["type"] == "slice" and "did not complete" in err:
                # The slicer's own lines say why the era produced no mosaic.
                cause = next((cause_of(ln) for ln in lines if hard(ln)), "slice incomplete")
            rec(row, "not run" if cause == "earlier step failed" else "failed", err, cause=cause,
                **({"log_tail": lines} if row["type"] != "slice" and lines else {}))
        if row["type"] == "slice":
            for ln in lines:
                rec(row, "error" if hard(ln) else "warning", ln)
            if res.get("attempt", 1) > 1:
                rec(row, "warning", "slice needed the --parallel-warp 1 retry", cause="retry")
        if row["type"] == "convert" and row["status"] == "succeeded":
            if res.get("aligned") is None and not res.get("skipped"):
                rec(row, "warning", "alignment unverified: no probe had chart coverage (publish needs --allow-unverified)",
                    cause="alignment")
            g2p = (detail.get("params") or {}).get("g2p_args") or []
            wanted = int(g2p[g2p.index("-min-zoom") + 1]) if "-min-zoom" in g2p[:-1] else None
            if wanted is not None and res.get("min_zoom") not in (None, wanted):
                rec(row, "warning", f"archive starts at z{res['min_zoom']}, not the requested z{wanted}", cause="zoom floor")

    # ---- per-era state, then the report
    eras = defaultdict(dict)
    for r in rows:
        if r.get("key"):
            eras[r["key"]][r["type"]] = r["status"]
    done = sum(1 for e in eras.values() if e.get("archive") == "succeeded")
    broken = sorted(k for k, e in eras.items() if any(v in ("failed", "cancelled", "interrupted") for v in e.values()))
    waiting = len(eras) - done - len(broken)
    status = Counter(r["status"] for r in rows)
    sev = Counter(r["severity"] for r in records)
    files = sorted({r["file"] for r in records if r["file"] and r["severity"] == "error"})
    md = [f"# Slicer run {run}: problems", "",
          f"*Generated {time.strftime('%F %T')} by `slicerctl errors {run}` from the server's job records and logs. "
          f"{'The run is still going (' + f'{waiting:,}' + ' eras queued or in progress), so this is a partial list.' if waiting else 'Every queued era has finished.'}*",
          "", "| | |", "|---|---|",
          f"| Eras queued in this run | {len(eras):,} |",
          f"| Eras archived (slice, convert, archive all succeeded) | {done:,} |",
          f"| Eras with a failed or cancelled step | {len(broken):,} |",
          f"| Eras still queued or running | {waiting:,} |",
          f"| Jobs | {', '.join(f'{n:,} {s}' for s, n in sorted(status.items()))} |",
          f"| Slicer error lines (✗, missing source, no data) | {sev['error']:,} |",
          f"| Slicer warnings (⚠) and soft findings | {sev['warning']:,} |",
          f"| Distinct source files named in an error line | {len(files):,} |", ""]

    def section(title, picked, note=None):
        if not picked:
            return
        md.extend([f"## {title}", ""] + ([note, ""] if note else []))
        groups = defaultdict(list)
        for r in picked:
            groups[r["cause"]].append(r)
        for cause, items in sorted(groups.items(), key=lambda kv: (-len(kv[1]), kv[0])):
            n_files = len({r["file"] for r in items if r["file"]})
            md.append(f"### {cause}: {len(items)}" + (f" ({n_files} source files)" if n_files else ""))
            md.append("")
            for r in items:
                md.append(f"- [ ] `{r['key']}` {r['step']}: {r['text']}")
            md.append("")

    section("Jobs that failed", [r for r in records if r["severity"] == "failed"],
            "The era has no new archive. `slicerctl retry JOB` reruns the step and the steps that were waiting on it; "
            "the job id and its last log lines are in errors.jsonl.")
    section("Slicer errors inside eras", [r for r in records if r["severity"] == "error"],
            "A chart that failed here is missing from its era's mosaic (and has no per-chart artifact) even when the era itself completed.")
    section("Warnings", [r for r in records if r["severity"] == "warning"])
    skipped = [r for r in records if r["severity"] == "not run"]
    if skipped:
        md.extend(["## Steps not run because an earlier step failed", "",
                   f"{len(skipped)} jobs across {len({r['key'] for r in skipped})} eras; they rerun with the failed job's retry.", ""])
    if not records:
        md.extend(["No failures, error lines or warnings so far.", ""])

    out_dir = Path(a.out).expanduser() if a.out else Path(a.repo).expanduser() / "worklists" / "data" / "slicer_runs" / run
    out_dir.mkdir(parents=True, exist_ok=True)
    (out_dir / "errors.jsonl").write_text("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in records))
    (out_dir / "errors.md").write_text("\n".join(md) + "\n")
    print(f"{run}: {len(eras):,} eras: {done:,} archived, {len(broken):,} with a failed step, {waiting:,} queued or running")
    print(f"  {sev['failed']:,} failed jobs, {sev['error']:,} slicer error lines ({len(files):,} source files), {sev['warning']:,} warnings")
    for cause, n in Counter(r["cause"] for r in records if r["severity"] in ("failed", "error")).most_common():
        print(f"    {n:5,}  {cause}")
    print(f"  → {out_dir / 'errors.md'}\n  → {out_dir / 'errors.jsonl'}")


# ---------------------------------------------------------------- sync

def cmd_sync(a):
    repo = Path(a.repo).expanduser()
    head = sh("git", "rev-parse", "--short", "HEAD", cwd=repo)
    porcelain = subprocess.run(["git", "status", "--porcelain", "--", "scripts", "shapefiles"], cwd=repo,
                               capture_output=True, text=True, check=True).stdout
    dirty = [ln[3:] for ln in porcelain.splitlines() if ln.strip()]
    rid = time.strftime("%Y%m%d-%H%M%S") + f"-{head}" + ("-dirty" if dirty else "")
    csv = repo / "master_dole_v2.csv"
    with tempfile.TemporaryDirectory() as td:
        stage = Path(td) / rid
        shutil.copytree(repo / "scripts", stage / "scripts",
                        ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))
        shutil.copytree(repo / "shapefiles", stage / "shapefiles")
        for f in ("master_dole_v2.csv", "dates.csv"):
            shutil.copy2(repo / f, stage / f)
        (stage / "chart_pmtiles").mkdir()
        for f in ("manifest.jsonl", "uploads.jsonl"):
            src = repo / "worklists" / "data" / "chart_pmtiles" / f
            if src.exists():
                shutil.copy2(src, stage / "chart_pmtiles" / f)
        meta = {"id": rid, "git_head": head, "dirty": dirty, "synced_at": time.strftime("%FT%T"),
                "csv_sha256": hashlib.sha256(csv.read_bytes()).hexdigest()[:16],
                "csv_rows": sum(1 for _ in open(csv)) - 1, "repo": str(repo)}
        (stage / "RELEASE.json").write_text(json.dumps(meta, indent=2) + "\n")
        say(f"release {rid}: scripts @ {head}{' + ' + str(len(dirty)) + ' dirty' if dirty else ''}, "
            f"{meta['csv_rows']} catalog rows")
        sh("rsync", "-a", f"{stage}/", f"{HOST}:{SERVER_CODE}/releases/{rid}/")
    keep = KEEP_RELEASES
    sh("ssh", HOST, f"set -e; cd {SERVER_CODE}; chown -R root:root releases/{rid}; chmod -R a+rX,go-w releases/{rid}; "
       f"ln -sfn releases/{rid} current.tmp && mv -T current.tmp current; "
       f"ls -1d releases/*/ | sort | head -n -{keep} | xargs -r rm -rf")
    say(f"current → {rid}")


# ---------------------------------------------------------------- worker
#
# The Mac as a second slicing machine. A worker thread claims one start-date
# group (the queued slice/convert/archive jobs of every era starting that day),
# runs the same release of slicer.py and the same patched converter the server
# would, writes the outputs into the run's directory on the share exactly where
# the server's archive step puts them, and reports each job back. Upload jobs
# stay on the server: they find the files on its HDD.
#
# Sources are read through a READ-ONLY mount of the share (kernel-enforced, like
# the server's bind mount), so nothing here can write into rawtiffs. An era
# whose source needs unpacking or converting in place fails on that mount and is
# handed back for the server, whose overlay takes such writes.

WORKER_SCRATCH = Path.home() / "slicerd-work"
WORKER_SOURCES = Path.home() / "mnt" / "projects-ro" / "rawtiffs"
SHARE_URL = "//Ryan@192.168.1.203/projects"
READONLY_RX = re.compile(r"Read-only file system|Errno 30\b|EROFS")
_wlock = __import__("threading").Lock()
_children = set()  # running slicer / converter processes, killed when the worker stops


def wapi(method, path, payload, hours=2):
    """api() for the worker's reports: keeps trying while the server is away (a deploy, a reboot)."""
    t0, told = time.time(), 0
    while True:
        try:
            return api(method, path, payload)
        except SystemExit as e:
            if "HTTP 4" in str(e) or time.time() - t0 > hours * 3600:
                raise RuntimeError(str(e))
            if time.time() - told > 300:  # say so: a worker that cannot report looks alive but does nothing
                say(f"cannot report to the server ({e}); retrying every 20 s")
                told = time.time()
            time.sleep(20)


def ensure_ro_sources(sources):
    mnt = sources.parent
    mounted = subprocess.run(["mount"], capture_output=True, text=True).stdout
    line = next((ln for ln in mounted.splitlines() if f" on {mnt} (" in ln), None)
    if line is None:
        mnt.mkdir(parents=True, exist_ok=True)
        sh("mount_smbfs", "-o", "rdonly,nobrowse", SHARE_URL, mnt)
        line = next((ln for ln in subprocess.run(["mount"], capture_output=True, text=True).stdout.splitlines()
                     if f" on {mnt} (" in ln), "")
    if "read-only" not in line:
        raise RuntimeError(f"{mnt} is not a read-only mount; the worker reads rawtiffs only through one")
    if not sources.is_dir():
        raise RuntimeError(f"{sources} not found on the read-only mount")


def ensure_release(rid, scratch):
    """The server's code release (scripts + catalog + shapefiles), copied once."""
    dest = scratch / "releases" / rid
    with _wlock:
        if not (dest / "RELEASE.json").exists():
            dest.parent.mkdir(parents=True, exist_ok=True)
            tmp = dest.with_name(rid + ".tmp")
            sh("rsync", "-a", "--delete", f"{HOST}:{SERVER_CODE}/releases/{rid}/", f"{tmp}/")
            os.replace(tmp, dest)
            for old in sorted(p for p in dest.parent.iterdir() if p.is_dir() and p.name != rid)[:-2]:
                shutil.rmtree(old, ignore_errors=True)
    return dest


def run_logged(args, log, cwd=None, env=None):
    args = [str(x) for x in args]
    log.append("$ " + shlex.join(args))
    p = subprocess.Popen(args, cwd=cwd, env={**os.environ, **(env or {})}, stdin=subprocess.DEVNULL,
                         stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace",
                         start_new_session=True)
    _children.add(p)
    try:
        text = p.communicate()[0]
    finally:
        _children.discard(p)
    log.append(text.rstrip("\n"))
    log.append(f"exit {p.returncode}")
    return p.returncode, text


def pm_head(path):
    import struct
    with open(path, "rb") as f:
        h = f.read(127)
    if h[:7] != b"PMTiles" or h[7] != 3:
        raise RuntimeError(f"{path}: not a PMTiles v3 archive")
    w, s, e, n = struct.unpack_from("<4i", h, 102)
    return {"min_zoom": h[100], "max_zoom": h[101], "tiles": struct.unpack_from("<Q", h, 72)[0],
            "bounds": [w / 1e7, s / 1e7, e / 1e7, n / 1e7]}


def share_put(src, dst):
    """Copy onto the share under a temporary name, check the size, then rename into place."""
    dst.parent.mkdir(parents=True, exist_ok=True)
    tmp = dst.with_name(dst.name + ".partial")
    shutil.copyfile(src, tmp)
    if tmp.stat().st_size != src.stat().st_size:
        raise RuntimeError(f"copy size mismatch for {dst}")
    os.replace(tmp, dst)
    return src.stat().st_size


def worker_group(a, claim, cid):
    """Run one claimed group. Returns {job id: (status, result, error, log text)}."""
    scratch, run, start = Path(a.scratch), claim["run"], claim["start"]
    rel = ensure_release(claim["release"], scratch)
    jobs = claim["jobs"]
    by = {(j["type"], j["key"]): j for j in jobs}
    keys = [j["key"] for j in jobs if j["type"] == "slice"]
    w = scratch / "runs" / run
    for sub in ("mosaics", "pmtiles", "logs", "charts"):
        (w / sub).mkdir(parents=True, exist_ok=True)
    temp, chart_temp = scratch / "temp" / run / start, scratch / "chartfull" / run / start
    share = SHARE_RUNS / run
    done, t0 = {}, time.time()
    sp = by["slice", keys[0]]["params"] or {}

    # ---- slice: one slicer run covers every era of the start date
    slog = [f"worker {a.name} on {os.uname().nodename}: slice of {start} ({len(keys)} eras), release {claim['release']}"]
    args = [a.python, "-u", rel / "scripts" / "slicer.py", "-s", a.sources, "-o", w / "mosaics", "-t", temp,
            "-c", rel / "master_dole_v2.csv", "-b", rel / "shapefiles", "-y", "--start-date", start, "--end-date", start,
            "--geotiff2pmtiles-bin", a.g2p, "--chart-temp", chart_temp]
    manifest = w / "charts" / "manifest.jsonl"
    if sp.get("charts"):
        with _wlock:
            if not manifest.exists():
                seed = rel / "chart_pmtiles" / "manifest.jsonl"
                if seed.exists():
                    shutil.copyfile(seed, manifest)
                    (w / "charts" / "manifest.seed_lines").write_text(str(sum(1 for _ in open(seed))) + "\n")
        args += ["--chart-pmtiles", w / "charts", "--chart-manifest", manifest]
    args += [str(x) for x in sp.get("slicer_args", [])]
    env = {"TMPDIR": str(scratch / "tmp"), "CPL_TMPDIR": str(scratch / "tmp")}
    (scratch / "tmp").mkdir(exist_ok=True)
    for k in keys:
        for m in (w / "mosaics" / f"{k}.tif", w / "mosaics" / f"{k}.partial.tif"):
            m.unlink(missing_ok=True)
    text = ""
    for attempt in (1, 2):
        extra = []
        if attempt == 2:
            slog.append("attempt 1 failed: wiping this date's temps and retrying with --parallel-warp 1")
            shutil.rmtree(temp, ignore_errors=True)
            extra = ["--parallel-warp", "1"]
        rc, text = run_logged(args + extra, slog, cwd=w / "logs", env=env)
        ok = {k: f"{k.upper()} GEOTIFF COMPLETE" in text and (w / "mosaics" / f"{k}.tif").exists() for k in keys}
        if (rc == 0 and all(ok.values())) or READONLY_RX.search(text):
            break
    for d in (temp, chart_temp):
        shutil.rmtree(d, ignore_errors=True)
    if READONLY_RX.search(text) and not all(ok.values()):
        return "local_only"  # a source needs writing next to it: the server's overlay handles that
    grid = re.findall(r"Mosaic grid: z(\d+)", text)
    fails = [ln.strip() for ln in text.splitlines() if "✗" in ln]
    # the slicer prints a chart's key (chart/<slug>/<date>); its mirror file is <slug>/<date>.pmtiles
    charts = sorted(set(re.findall(r"chart pmtiles: chart/(\S+) \(", text)))
    for k in keys:
        j = by["slice", k]
        m = w / "mosaics" / f"{k}.tif"
        if ok[k]:
            done[j["id"]] = ("succeeded", {"mosaic": str(share / "mosaics" / m.name), "size_gb": round(m.stat().st_size / 1e9, 2),
                                           "grid_zoom": int(grid[0]) if grid else None, "attempt": attempt,
                                           "seconds": round(time.time() - t0), "failure_lines": len(fails),
                                           "failure_samples": fails[:8]}, None, "\n".join(slog))
        else:
            done[j["id"]] = ("failed", None, f"RuntimeError: slicer did not complete {k} (see log)", "\n".join(slog))

    # ---- convert + archive, era by era
    for k in keys:
        cj, aj = by.get(("convert", k)), by.get(("archive", k))
        if not ok[k]:
            for j in (cj, aj):
                if j:
                    done[j["id"]] = ("cancelled", None, f"dependency {j['depends_on']} failed", None)
            continue
        m, out, part = w / "mosaics" / f"{k}.tif", w / "pmtiles" / f"{k}.pmtiles", w / "pmtiles" / f"{k}.part.pmtiles"
        stamp, align_log = w / "logs" / f"converter_{k}.txt", w / "logs" / f"align_{k}.log"
        res = None
        if cj:
            clog, p, t1 = [f"worker {a.name}: convert {k}"], cj["params"] or {}, time.time()
            try:
                dt, nb = sh(a.python, "-c", "import sys; from osgeo import gdal; d = gdal.Open(sys.argv[1]); "
                            "print(gdal.GetDataTypeName(d.GetRasterBand(1).DataType), d.RasterCount)", m).split()
                gargs = [a.g2p, "-format", p.get("format", "webp"), "-quality", str(p.get("quality", 80)),
                         "-concurrency", str(int(p.get("concurrency") or a.concurrency)), "-mem-limit", "6000"]
                if dt != "Byte":
                    gargs += ["-rescale", "linear", "-rescale-range", "0,65535", "-alpha-band", nb]
                gargs += [str(x) for x in p.get("g2p_args", [])]
                part.unlink(missing_ok=True)
                rc, _ = run_logged(gargs + [m, part], clog)
                if rc != 0:
                    raise RuntimeError(f"geotiff2pmtiles rc={rc}")
                os.replace(part, out)
                stamp.write_text(cid + "\n")
                hdr = pm_head(out)
                tol = float(p.get("align_tol", 0.3))
                rc, atext = run_logged([a.python, Path(a.repo) / "slicerd" / "app" / "verify_align.py", m, out, "--tol", tol,
                                        "--zoom", hdr["max_zoom"], "--auto-probes"], clog)
                align_log.write_text(atext)
                mm = re.search(r"worst \|shift\| ([\d.]+) px over (\d+) probes", atext)
                if not mm:
                    raise RuntimeError(f"alignment check crashed (rc={rc})")
                worst, probes = float(mm.group(1)), int(mm.group(2))
                res = {"pmtiles": str(share / "pmtiles" / out.name), "size_gb": round(out.stat().st_size / 1e9, 2), **hdr,
                       "seconds": round(time.time() - t1), "converter": cid, "align_worst_px": worst,
                       "align_probes": probes, "align_tol": tol, "aligned": (worst <= tol) if probes else None}
                if probes and worst > tol:
                    raise RuntimeError(f"misaligned: worst {worst} px > tol {tol}")
                done[cj["id"]] = ("succeeded", res, None, "\n".join(clog))
            except Exception as e:
                done[cj["id"]] = ("failed", None, f"{type(e).__name__}: {e}", "\n".join(clog))
                if aj:
                    done[aj["id"]] = ("cancelled", None, f"dependency {cj['id']} failed", None)
                continue
        if aj:
            alog, p, moved, total = [f"worker {a.name}: archive {k} -> {share}"], aj["params"] or {}, [], 0
            try:
                # The mosaic goes last: the server skips a slice whose mosaic is archived, so an
                # archive cut short before it is redone in full (charts stranded here 2026-10-04).
                items = [(f, share / "logs" / f.name) for f in sorted((w / "logs").glob(f"*{k}*"))]
                if p.get("charts", True):
                    items += [(w / "charts" / f"{c}.pmtiles", share / "charts" / f"{c}.pmtiles") for c in charts
                              if (w / "charts" / f"{c}.pmtiles").exists()]
                if out.exists():
                    items.append((out, share / "pmtiles" / out.name))
                if p.get("mosaic", "move") == "move":
                    items.append((m, share / "mosaics" / m.name))
                for src, dst in items:
                    total += share_put(src, dst)
                    moved.append(str(dst.relative_to(share)))
                    src.unlink()
                m.unlink(missing_ok=True)
                with _wlock:  # this worker's chart records, beside the server's own manifest.jsonl
                    seed = int((w / "charts" / "manifest.seed_lines").read_text()) if (w / "charts" / "manifest.seed_lines").exists() else 0
                    if manifest.exists():
                        (share / "charts").mkdir(parents=True, exist_ok=True)
                        (share / "charts" / f"manifest.worker-{a.name}.jsonl").write_text(
                            "".join(open(manifest).readlines()[seed:]))
                alog += [f"  ✓ {x}" for x in moved]
                done[aj["id"]] = ("succeeded", {"archived": moved, "total_gb": round(total / 1e9, 2), "dest": str(share)},
                                  None, "\n".join(alog))
            except Exception as e:
                done[aj["id"]] = ("failed", None, f"{type(e).__name__}: {e}", "\n".join(alog))
    with _wlock:  # the review CSVs are shared by every group in flight; never fail a group over one
        for f in (w / "mosaics").glob("processing_review_*.csv"):
            try:
                share_put(f, share / "mosaics" / f.name)
                f.unlink()
            except (OSError, RuntimeError):
                pass
    return done


def cmd_worker(a):
    import threading
    scratch = Path(a.scratch).expanduser()
    a.sources = Path(a.sources).expanduser()
    for need in (a.g2p, a.python):
        if not Path(need).exists():
            raise RuntimeError(f"{need} not found")
    if not SHARE_RUNS.is_dir():
        raise RuntimeError(f"{SHARE_RUNS} is not mounted (outputs are written there)")
    ensure_ro_sources(a.sources)
    cid = "b300c9e+halfpx darwin-arm64 sha256:" + hashlib.sha256(Path(a.g2p).read_bytes()).hexdigest()[:8]
    stop, held, hl = threading.Event(), set(), threading.Lock()
    say(f"worker {a.name}: {a.jobs} groups at a time, eras up to {a.max_charts} charts, converter {cid}")

    def beat():
        missed = 0
        while not stop.wait(60):
            try:
                api("POST", "/api/heartbeat", {"worker": a.name})
                missed = 0
            except (SystemExit, Exception) as e:
                missed += 1
                if missed in (1, 5) or missed % 30 == 0:
                    say(f"heartbeat failed x{missed} ({e}); the server requeues this worker's claims after 15 min")

    def loop(n):
        while not stop.is_set():
            try:
                claim = api("POST", "/api/claim", {"worker": a.name, "max_charts": a.max_charts, "run": a.run})
            except SystemExit as e:
                say(f"claim failed ({e}); retrying in 60 s")
                claim = {"jobs": []}
            if not claim.get("jobs"):
                if a.once:
                    say(f"nothing to claim: {claim.get('reason')}")
                    return
                stop.wait(60)
                continue
            ids = [j["id"] for j in claim["jobs"]]
            with hl:
                held.update(ids)
            t0 = time.time()
            say(f"[{n}] {claim['start']}: {sum(j['type'] == 'slice' for j in claim['jobs'])} eras")
            try:
                done = worker_group(a, claim, cid)
            except Exception as e:
                say(f"[{n}] {claim['start']}: worker error {type(e).__name__}: {e}; handing the group back")
                done = None
            if done == "local_only" or done is None:
                wapi("POST", "/api/release", {"worker": a.name, "ids": ids, "local_only": done == "local_only"})
                say(f"[{n}] {claim['start']}: handed back" + (" (needs the server's source overlay)" if done else ""))
                if done is None:
                    stop.wait(30)
            else:
                # dependents after their dependencies: a finished chain reads slice, convert, archive
                for j in claim["jobs"]:
                    st, res, err, log = done.get(j["id"], ("failed", None, "worker produced no result", None))
                    try:
                        wapi("POST", f"/api/jobs/{j['id']}/finish", {"worker": a.name, "status": st, "result": res,
                                                                      "error": err, "log": (log or "")[-2_000_000:]})
                    except RuntimeError as e:  # e.g. the claim expired and the server took the job back
                        say(f"[{n}] {j['type']} {j['key']}: report refused: {e}")
                bad = [f"{j['type']} {j['key']}" for j in claim["jobs"] if done.get(j["id"], ("failed",))[0] != "succeeded"]
                say(f"[{n}] {claim['start']}: {'✓' if not bad else '✗ ' + ', '.join(bad[:3])} {time.time() - t0:.0f}s")
            with hl:
                held.difference_update(ids)
            if a.once:
                return

    import signal

    def on_term(*_):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, on_term)
    threading.Thread(target=beat, daemon=True).start()
    threads = [threading.Thread(target=loop, args=(i + 1,), daemon=True) for i in range(1 if a.once else a.jobs)]
    for t in threads:
        t.start()
        time.sleep(2)
    try:
        while any(t.is_alive() for t in threads):
            time.sleep(1)
    except KeyboardInterrupt:
        stop.set()
        say("stopping: killing running steps and handing unfinished groups back to the queue")
        for p in list(_children):
            try:
                os.killpg(p.pid, 15)
            except ProcessLookupError:
                pass
        with hl:
            ids = sorted(held)
        if ids:
            try:
                api("POST", "/api/release", {"worker": a.name, "ids": ids})
            except SystemExit as e:
                say(f"release failed: {e} (the server requeues them after 15 min without a heartbeat)")
        os._exit(130)


# ---------------------------------------------------------------- publish (Mac half)

UA = {"User-Agent": "archive-slicer-publish", "Cache-Control": "no-cache", "Pragma": "no-cache"}
BLOCK = 1 << 20


def fetch(url, start=None, end=None, timeout=120):
    h = dict(UA)
    if start is not None:
        h["Range"] = f"bytes={start}-{end}"
    for attempt in range(5):
        try:
            with urllib.request.urlopen(urllib.request.Request(url, headers=h), timeout=timeout) as r:
                return r.status, r.read(), r.headers
        except Exception:
            if attempt == 4:
                raise
            time.sleep(2 ** attempt)


def git_preflight(repo):
    sh("git", "fetch", "-q", "origin", "main", cwd=repo)
    if sh("git", "rev-parse", "--abbrev-ref", "HEAD", cwd=repo) != "main":
        raise RuntimeError("repo is not on main")
    if sh("git", "rev-list", "origin/main..HEAD", cwd=repo):
        raise RuntimeError("local main has unpushed commits; not pushing them along with this publish")
    if sh("git", "rev-list", "HEAD..origin/main", cwd=repo):
        sh("git", "pull", "--ff-only", "-q", "origin", "main", cwd=repo)
    dirty = sh("git", "status", "--porcelain", "--", "index.html", "src", "assets", cwd=repo)
    if dirty:
        raise RuntimeError(f"deploy files not clean: {dirty[:200]}")


def wait_pages(repo, sha, timeout=1200):
    t0 = time.time()
    while time.time() - t0 < timeout:
        runs = json.loads(sh("gh", "run", "list", "--limit", "20", "--json", "name,status,conclusion,headSha",
                             cwd=repo))
        dep = next((r for r in runs if r["name"] == "Deploy site to GitHub Pages" and r["headSha"] == sha), None)
        if dep and dep["status"] == "completed":
            if dep["conclusion"] == "success":
                return time.time() - t0
            raise RuntimeError("Pages workflow failed: " + dep["conclusion"])
        time.sleep(15)
    raise RuntimeError("Pages deploy not seen within 20 min")


def verify_live(base, key, bundle_path, size, prefix_sha256, edge_refresh=True):
    m = None
    for _ in range(40):  # GitHub Pages' CDN can serve the previous index.html for ~10 min
        _, html, _ = fetch(f"https://archive.aero/?cb={int(time.time())}")
        m = re.search(rb'data-viewer-preload href="(/assets/viewer\.[0-9a-f]+\.js)"', html)
        if not m:
            raise RuntimeError("live index.html: no viewer module preload")
        _, mod, _ = fetch(f"https://archive.aero{m.group(1).decode()}?cb={int(time.time())}")
        if bundle_path.name.encode() in mod:
            break
        time.sleep(30)
    else:
        raise RuntimeError(f"live viewer module still does not name {bundle_path.name} after 20 min")
    st, data, hdr = fetch(base + bundle_path.name, 0, 1023)
    total = int(hdr["Content-Range"].rsplit("/", 1)[1])
    if st != 206 or total != bundle_path.stat().st_size or data != bundle_path.read_bytes()[:1024]:
        raise RuntimeError(f"bundle through CDN: status {st} total {total}")
    url = f"{base}{key}.pmtiles"
    st, data, hdr = fetch(url, 0, BLOCK - 1)
    total = int(hdr["Content-Range"].rsplit("/", 1)[1])
    if st != 206 or total != size or hashlib.sha256(data).hexdigest() != prefix_sha256:
        raise RuntimeError(f"era through CDN: status {st} total {total} vs {size}, or first MiB differs")
    n = (size + BLOCK - 1) // BLOCK
    if not edge_refresh:
        return m.group(1).decode(), 0

    def blk(i):
        s, b, _ = fetch(url, i * BLOCK, min((i + 1) * BLOCK, size) - 1)
        return s == 206 and len(b) == min(BLOCK, size - i * BLOCK)
    with concurrent.futures.ThreadPoolExecutor(max_workers=8) as ex:
        ok = sum(ex.map(blk, range(1, n))) + 1
    if ok != n:
        raise RuntimeError(f"era edge refresh: {ok}/{n} blocks OK")
    return m.group(1).decode(), n


def cmd_publish(a):
    repo = Path(a.repo).expanduser()
    run, key = a.run, a.key
    t0 = time.time()
    if not SHARE_RUNS.parent.is_dir():
        raise RuntimeError("/Volumes/projects is not mounted (the bundle is read from the share)")
    if a.finish_only:
        ledger = SHARE_RUNS / run / "logs" / "uploaded.jsonl"
        recs = [json.loads(ln) for ln in open(ledger) if ln.strip()] if ledger.exists() else []
        recs = [r for r in recs if r.get("key") == key and not r.get("dry_run")]
        if not recs:
            raise RuntimeError(f"no upload record for {key} in {ledger}")
        say(f"finishing the git half for the upload of {recs[-1].get('uploaded_at')} ({recs[-1]['bundle']})")
        return finish_publish(a, repo, run, key, recs[-1], t0)
    if not a.dry_run:
        git_preflight(repo)
        say("git preflight ok")
    params = {"run": run, "key": key, "dry_run": a.dry_run, "confirm": not a.dry_run,
              "allow_new": a.allow_new, "allow_unverified": a.allow_unverified,
              "max_tile_delta": a.max_tile_delta}
    j = api("POST", "/api/jobs", {"type": "publish", "params": params})
    say(f"server job {j['id']}: eligibility, bundle{'' if a.dry_run else ', bundle + era upload'}")
    j = wait_job(j["id"])
    if j["status"] != "succeeded":
        sys.exit(f"✗ server half {j['status']}: {j.get('error')}")
    res = j["result"]
    if a.dry_run:
        say(f"dry run ok: would publish {key} with bundle {res['bundle']} ({res['eras']} eras); nothing uploaded")
        return
    try:
        finish_publish(a, repo, run, key, res, t0)
    except Exception as e:
        say(f"✗ {key} and {res['bundle']} ARE ON R2 but the viewer was not updated: {e}")
        say(f"  fix the cause, then: slicerctl publish {run} {key} --finish-only")
        sys.exit(1)


def finish_publish(a, repo, run, key, res, t0):
    src = SHARE_RUNS / run / "bundles" / res["bundle"]
    bundle = repo / res["bundle"]
    shutil.copy2(src, bundle)  # keep every metadata-*.bundle (analytics offsets)
    t_up = time.time()
    git_preflight(repo)
    sys.path.insert(0, str(repo / "scripts"))
    from viewer_config import update_viewer_config
    update_viewer_config(repo / "index.html", "bundleUrl", res["bundle_url"])
    sh("git", "add", "index.html", "src/viewer.js", "assets", cwd=repo)
    verb = "Publish" if res.get("new_era") else "Republish"
    msg = a.message or (
        f"{verb} {key}\n\n"
        f"Sliced and converted on the NUC (archive-slicer run {run}; {res['converter']});\n"
        f"tiles vs mosaic worst {res['worst_px']} px over {res['probes']} probes.\n\n"
        f"Bundle {res['bundle']} ({res['eras']} eras); viewer config + hashed assets\n"
        f"regenerated. Same-key republish: other colos' block caches age out <=24 h.")
    sh("git", "commit", "-q", "-m", msg, "--", "index.html", "src/viewer.js", "assets", cwd=repo)
    sha = sh("git", "rev-parse", "HEAD", cwd=repo)
    sh("git", "push", "-q", "origin", "main", cwd=repo)
    say(f"pushed {sha[:7]} {time.time() - t_up:.0f}s after the era upload finished")
    waited = wait_pages(repo, sha)
    base = res["bundle_url"][: -len(res["bundle"])]
    module, n = verify_live(base, key, bundle, res["era_size"], res["prefix_sha256"],
                            edge_refresh=not a.no_edge_refresh)
    say(f"✓ {key}: live (Pages {waited:.0f}s, {module} → {res['bundle']}, {n} blocks refreshed) "
        f"{time.time() - t0:.0f}s total")
    with open(SHARE_RUNS / run / "logs" / "published.jsonl", "a") as f:
        f.write(json.dumps({"key": key, "bundle": res["bundle"], "commit": sha, "worst_px": res["worst_px"],
                            "converter": res["converter"], "published_at": time.strftime("%FT%T")}) + "\n")


# ---------------------------------------------------------------- main

def main():
    ap = argparse.ArgumentParser(prog="slicerctl", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    sp.add_parser("status").set_defaults(fn=cmd_status)
    p = sp.add_parser("jobs"); p.add_argument("--status"); p.add_argument("--run"); p.add_argument("-n", type=int, default=30); p.set_defaults(fn=cmd_jobs)
    p = sp.add_parser("job"); p.add_argument("id"); p.add_argument("--tail", type=int, default=40); p.set_defaults(fn=cmd_job)
    p = sp.add_parser("log"); p.add_argument("id"); p.add_argument("-n", type=int, default=200); p.add_argument("--grep"); p.add_argument("-f", "--follow", action="store_true"); p.set_defaults(fn=cmd_log)
    p = sp.add_parser("wait"); p.add_argument("id"); p.add_argument("-q", "--quiet", action="store_true"); p.set_defaults(fn=cmd_wait)
    p = sp.add_parser("eras"); p.add_argument("--start"); p.add_argument("--end"); p.add_argument("--contains"); p.add_argument("--limit", type=int, default=5000); p.set_defaults(fn=cmd_eras)
    p = sp.add_parser("pipeline"); p.add_argument("run"); p.add_argument("keys", nargs="*")
    p.add_argument("--keys-from"); p.add_argument("--steps", default="slice,convert,archive")
    p.add_argument("--charts", action="store_true"); p.add_argument("--slicer-args", help='e.g. "--parallel-warp 6"')
    p.add_argument("--concurrency", type=int); p.add_argument("--mosaic", default="move", choices=("move", "delete", "keep"))
    p.add_argument("--min-zoom", type=int, default=0, help="lowest zoom in the era archive (default 0; -1 = the converter's auto floor)")
    p.add_argument("--force", action="store_true"); p.set_defaults(fn=cmd_pipeline)
    p = sp.add_parser("submit"); p.add_argument("type"); p.add_argument("--run"); p.add_argument("--key")
    p.add_argument("--param", action="append", help="k=v (v parsed as JSON when possible)"); p.add_argument("--after")
    p.set_defaults(fn=cmd_submit)
    for name, fn in (("cancel", cmd_cancel), ("retry", cmd_retry)):
        p = sp.add_parser(name); p.add_argument("id"); p.set_defaults(fn=fn)
    sp.add_parser("pause").set_defaults(fn=cmd_pause)
    sp.add_parser("resume").set_defaults(fn=cmd_resume)
    sp.add_parser("runs").set_defaults(fn=cmd_runs)
    sp.add_parser("remount").set_defaults(fn=cmd_remount)
    p = sp.add_parser("run"); p.add_argument("run"); p.set_defaults(fn=cmd_run)
    p = sp.add_parser("overlay"); p.add_argument("--stale", action="store_true"); p.set_defaults(fn=cmd_overlay)
    p = sp.add_parser("cleanup"); p.add_argument("run"); p.add_argument("--key"); p.add_argument("--what", default="temp"); p.set_defaults(fn=cmd_cleanup)
    p = sp.add_parser("errors"); p.add_argument("run"); p.add_argument("--out", help="output directory (default <repo>/worklists/data/slicer_runs/RUN)")
    p.add_argument("--repo", default=str(DEFAULT_REPO)); p.set_defaults(fn=cmd_errors)
    p = sp.add_parser("sync"); p.add_argument("--repo", default=str(DEFAULT_REPO)); p.set_defaults(fn=cmd_sync)
    p = sp.add_parser("set"); p.add_argument("kv", nargs="*", help="cpu_slots=8 io_slots=2 hashed_remote=r2:BUCKET"); p.set_defaults(fn=cmd_set)
    p = sp.add_parser("worker"); p.add_argument("--name", default="mac"); p.add_argument("--jobs", type=int, default=3)
    p.add_argument("--max-charts", type=int, default=4, help="largest era (catalog rows) this Mac takes")
    p.add_argument("--run", help="only this run"); p.add_argument("--once", action="store_true", help="one group, then stop")
    p.add_argument("--scratch", default=str(WORKER_SCRATCH)); p.add_argument("--sources", default=str(WORKER_SOURCES))
    p.add_argument("--g2p", default=str(WORKER_SCRATCH / "bin" / "geotiff2pmtiles")); p.add_argument("--python", default=str(Path.home() / "venv" / "bin" / "python"))
    p.add_argument("--concurrency", type=int, default=4, help="geotiff2pmtiles threads per convert")
    p.add_argument("--repo", default=str(DEFAULT_REPO)); p.set_defaults(fn=cmd_worker)
    p = sp.add_parser("publish"); p.add_argument("run"); p.add_argument("key")
    p.add_argument("--repo", default=str(DEFAULT_REPO)); p.add_argument("--dry-run", action="store_true")
    p.add_argument("--allow-new", action="store_true"); p.add_argument("--allow-unverified", action="store_true")
    p.add_argument("--max-tile-delta", type=float, default=0.02); p.add_argument("--message")
    p.add_argument("--no-edge-refresh", action="store_true")
    p.add_argument("--finish-only", action="store_true", help="only the Mac/git half, after an upload whose push failed")
    p.set_defaults(fn=cmd_publish)
    a = ap.parse_args()
    try:
        a.fn(a)
    except RuntimeError as e:
        sys.exit(f"✗ {e}")


if __name__ == "__main__":
    main()
