#!/usr/bin/env python3
"""slicerctl — drive the archive-slicer container on the OMV NUC from the Mac.

  slicerctl status                         host + queue summary
  slicerctl eras [--start D] [--end D] [--contains S]
  slicerctl pipeline RUN KEY... [--steps slice,convert,archive[,upload]] [--charts]
                     [--slicer-args "--parallel-warp 6"] [--concurrency N] [--min-zoom 0]
                     [--mosaic move|delete|keep] [--force] [--keys-from FILE]
  slicerctl submit TYPE --run RUN [--key KEY] [--param k=v ...] [--after JOB]
  slicerctl jobs [--status running,queued] [--run RUN] [-n 30]
  slicerctl job ID [--tail 40]       slicerctl log ID [-n 200] [--grep RX] [-f]
  slicerctl wait ID                  block until the job finishes
  slicerctl cancel ID | retry ID | pause | resume
  slicerctl runs | run RUN | overlay [--stale] | remount | cleanup RUN [--key K] [--what temp,mosaic]
  slicerctl errors RUN [--out DIR]   every failed job and every slicer ✗/⚠ line of a run, by cause
  slicerctl sync [--repo PATH]       push scripts + catalog to the server as a new code release
  slicerctl set [KEY=VALUE ...]      server settings: cpu_slots, io_slots, hashed_remote (no args: show)
  slicerctl worker [--jobs 3] [--max-charts 4] [--run RUN] [--once]
                                     take start-date groups off the queue and run them on this Mac
  slicerctl publish RUN KEY [--dry-run] [--allow-new] [--allow-unverified]
                    [--max-tile-delta 0.02] [--message MSG] [--no-edge-refresh] [--finish-only]

Config: ~/.config/slicerd/config.json {"url": ..., "token": ...}
(or SLICERD_URL / SLICERD_TOKEN). The repo defaults to ~/archive.aero.
"""
import argparse
