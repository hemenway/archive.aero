    pkg = temps.get("Package id 0", max(temps.values()) if temps else None)
    print(f"controller up since {s['controller_started']}{'  [PAUSED]' if s['paused'] else ''}")
    print(f"code release {s['code_release'].get('id')}  (git {s['code_release'].get('git_head')}, "
          f"synced {s['code_release'].get('synced_at')})")
