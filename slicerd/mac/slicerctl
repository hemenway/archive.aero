def cmd_jobs(a):
    q = f"?limit={a.n}" + (f"&status={a.status}" if a.status else "") + (f"&run={a.run}" if a.run else "")
    for j in api("GET", "/api/jobs" + q):
        extra = j.get("error") or j.get("blocked") or j.get("last_line") or ""
        print(f"{j['id']}  {j['status']:11s} {j['type']:8s} {j['run'] or '':24s} {j['key'] or '':26s} {extra[:90]}")


def cmd_job(a):
    out(api("GET", f"/api/jobs/{a.id}?tail={a.tail}"))


def cmd_log(a):
    q = f"?lines={a.n}" + (f"&grep={urllib.request.quote(a.grep)}" if a.grep else "")
    lines = api("GET", f"/api/jobs/{a.id}/log{q}")
    print("\n".join(lines))
    if a.follow:
        last = lines[-1] if lines else None
        while True:
            j = api("GET", f"/api/jobs/{a.id}")
            new = api("GET", f"/api/jobs/{a.id}/log?lines=400")
            if last in new:
                new = new[len(new) - new[::-1].index(last):]
            for ln in new:
                print(ln, flush=True)
            if new:
                last = new[-1]
            if j["status"] not in ("queued", "running"):
                print(f"-- {j['status']}: {j.get('error') or ''}")
                return
            time.sleep(5)


def wait_job(jid, quiet=False):
    last = None
    while True:
        j = api("GET", f"/api/jobs/{jid}")
        if not quiet:
            new = api("GET", f"/api/jobs/{jid}/log?lines=400")
            if last in new:
                new = new[len(new) - new[::-1].index(last):]
            for ln in new:
                print("  " + ln, flush=True)
            if new:
                last = new[-1]
        if j["status"] not in ("queued", "running"):
            return j
        time.sleep(5)


def cmd_wait(a):
    j = wait_job(a.id, quiet=a.quiet)
    out({k: j.get(k) for k in ("id", "status", "error", "result")})
    sys.exit(0 if j["status"] == "succeeded" else 1)


