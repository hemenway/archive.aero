{
  "name": "archive-aero-regression-tests",
  "private": true,
  "scripts": {
    "test": "npm run check:frontend && npm run check:next && npm run test:frontend && npm run test:workers && npm run test:dataplane && npm run test:browser && npm run test:next",
    "test:frontend": "python3 -m unittest discover -s tests -p 'test_viewer_config.py'",
    "build:frontend": "node scripts/build_frontend.mjs",
    "vendor:frontend": "node scripts/vendor_frontend.mjs",
    "check:frontend": "node scripts/vendor_frontend.mjs --check && node scripts/build_frontend.mjs --check",
    "test:workers": "node --test worker/test/*.test.mjs worker-atc/test/*.test.mjs",
    "test:browser": "playwright test",
    "build:next": "node next/build.mjs --stubs",
    "check:next": "node next/build.mjs --check",
    "test:next": "npm run build:next && playwright test --config next/playwright.config.mjs",
    "test:dataplane": "node --test next/dataplane/test/*.test.mjs",
    "test:renderer": "playwright test --config next/renderer/playwright.config.mjs",
    "test:next:real": "playwright test --config next/tests-real/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "esbuild": "0.28.2",
    "leaflet": "1.9.4",
    "papaparse": "5.4.1",
    "pmtiles": "3.0.6",
    "protomaps-leaflet": "5.0.0"
  }
}
